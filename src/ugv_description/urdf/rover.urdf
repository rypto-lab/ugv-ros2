<?xml version="1.0"?>
<robot name="rover">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.32" rpy="0 0 0"/>
      <geometry>
        <box size="1.6 0.9 0.32"/>
      </geometry>
      <material name="body">
        <color rgba="0.9 0.25 0.05 1"/>
      </material>
    </visual>
  
  <!-- TOP DECK -->
  <visual>
    <origin xyz="0 0 0.54" rpy="0 0 0"/>
    <geometry>
      <box size="1.25 0.72 0.12"/>
    </geometry>
    <material name="deck">
      <color rgba="0.15 0.18 0.20 1"/>
    </material>
  </visual>

  <!-- FRONT BUMPER -->
  <visual>
    <origin xyz="0.84 0 0.22" rpy="0 0 0"/>
    <geometry>
      <box size="0.12 1.05 0.14"/>
    </geometry>
    <material name="bumper">
      <color rgba="0.05 0.05 0.05 1"/>
    </material>
  </visual>

  <!-- LIDAR MAST -->
  <visual>
    <origin xyz="0 0 0.76" rpy="0 0 0"/>
    <geometry>
      <cylinder radius="0.035" length="0.42"/>
    </geometry>
    <material name="mast">
      <color rgba="0.10 0.10 0.10 1"/>
    </material>
  </visual>

  <!-- LIDAR -->
  <visual>
    <origin xyz="0 0 0.98" rpy="0 0 0"/>
    <geometry>
      <cylinder radius="0.12" length="0.10"/>
    </geometry>
    <material name="lidar">
      <color rgba="0.70 0.70 0.70 1"/>
    </material>
  </visual>
</link>

  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.22"/>
      </geometry>
      <material name="wheel">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.55 0.65 0.28" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.22"/>
      </geometry>
      <material name="wheel">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.55 -0.65 0.28" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.22"/>
      </geometry>
      <material name="wheel">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.55 0.65 0.28" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.22"/>
      </geometry>
      <material name="wheel">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.55 -0.65 0.28" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>



  <!-- CAMERA LINK -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.12 0.08"/>
      </geometry>
      <material name="camera">
        <color rgba="0.02 0.02 0.02 1"/>
      </material>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.72 0 0.48" rpy="0 0 0"/>
  </joint>

</robot>
