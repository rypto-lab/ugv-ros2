<?xml version="1.0"?>
<robot name="rover">

  <link name="base_link">

    <!-- CHASSIS -->
    <visual>
      <origin xyz="0 0 0.32" rpy="0 0 0"/>
      <geometry>
        <box size="1.6 0.9 0.32"/>
      </geometry>
      <material name="body">
        <color rgba="0.9 0.25 0.05 1"/>
      </material>
    </visual>

    <!-- FRONT LEFT WHEEL -->
    <visual>
      <origin xyz="0.55 0.65 0.28" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.22"/>
      </geometry>
      <material name="wheel">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>

    <!-- FRONT RIGHT WHEEL -->
    <visual>
      <origin xyz="0.55 -0.65 0.28" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.22"/>
      </geometry>
      <material name="wheel2">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>

    <!-- REAR LEFT WHEEL -->
    <visual>
      <origin xyz="-0.55 0.65 0.28" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.22"/>
      </geometry>
      <material name="wheel3">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>

    <!-- REAR RIGHT WHEEL -->
    <visual>
      <origin xyz="-0.55 -0.65 0.28" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.22"/>
      </geometry>
      <material name="wheel4">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>

  </link>

</robot>
